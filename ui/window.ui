<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkBox" id="root_box">
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwBanner" id="banner">
        <property name="title"></property>
        <property name="revealed">False</property>
      </object>
    </child>
    <child>
      <object class="AdwHeaderBar" id="header">
        <child type="start">
          <object class="GtkButton" id="refresh_btn">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text">Re-detect monitors</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox" id="header_right">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="load_btn">
                <property name="label">Load</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="save_btn">
                <property name="label">Save</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="content_box">
        <property name="orientation">horizontal</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkScrolledWindow" id="sidebar_scroll">
            <property name="hscrollbar-policy">never</property>
            <property name="min-content-width">200</property>
            <child>
              <object class="GtkListView" id="monitor_list"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="vsep">
            <property name="orientation">vertical</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="controls_box">
            <property name="orientation">vertical</property>
            <property name="hexpand">True</property>
            <property name="spacing">12</property>
            <property name="margin-start">18</property>
            <property name="margin-end">18</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkStack" id="controls_stack">
                <property name="transition-type">crossfade</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkStackPage" id="page_empty">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="GtkLabel">
                        <property name="label">Select a monitor</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage" id="page_controls">
                    <property name="name">controls</property>
                    <property name="child">
                      <object class="GtkBox" id="sliders_container">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
